<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- VUE LISTE -->

        <record id="view_it_equipment_category_list" model="ir.ui.view">
            <field name="name">it.equipment.category.list</field>
            <field name="model">it.equipment.category</field>

            <field name="arch" type="xml">
                <list sample="1" limit="10">
                    <field name="name"/>
                    <field name="max_loan_days" width="150px"/>
                    <field name="requires_approval" widget="boolean_toggle" width="200px"/>
                    <field name="equipment_count" width="200px"/>
                </list>
            </field>
        </record>

        <!-- VUE FORMULAIRE -->

        <record id="view_it_equipment_category_form" model="ir.ui.view">
            <field name="name">it.equipment.category.form</field>
            <field name="model">it.equipment.category</field>

            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <!-- Titre principal -->
                        <div class="oe_title">
                            <label for="name"/>
                            <h1>
                                <field name="name" placeholder="Ex: Ordinateurs Portables, Périphériques..."/>
                            </h1>
                        </div>

                        <!-- Paramètres de la catégorie -->
                        <group>
                            <group string="Configuration des prêts" name="loan_config">
                                <field name="max_loan_days"/>
                                <field name="requires_approval" widget="boolean_toggle"/>
                            </group>
                            <group string="Statistiques" name="statistics">
                                <field name="equipment_count" readonly="1"/>
                            </group>
                        </group>

                        <!-- Affichage des équipements liés via le champ One2many -->
                        <notebook>
                            <page string="Équipements liés" name="equipments">
                                <field name="equipment_ids" readonly="1">
                                    <list>
                                        <field name="name"/>
                                        <field name="reference"/>
                                        <field name="serial_number"/>
                                        <field name="state" widget="badge" decoration-success="state == 'available'" decoration-info="state == 'loaned'" decoration-warning="state =='maintenance'" decoration-danger="state == 'retired'" />
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- ACTION -->

        <record id="action_it_equipment_category" model="ir.actions.act_window">
            <field name="name">Gestion des catégories</field>
            <field name="res_model">it.equipment.category</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Créez votre première Catégorie d'équipement !
                </p>
            </field>
        </record>

        <!-- MENU -->

        <menuitem 
            id="menu_it_equipment_category" 
            name="Catégories" 
            parent="menu_it_equipment_master" 
            action="action_it_equipment_category" 
            sequence="10" 
        />
    </data>
</odoo>