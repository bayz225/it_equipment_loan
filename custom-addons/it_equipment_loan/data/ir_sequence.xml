<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data noupdate="1">
        <record id="seq_it_equipment" model="ir.sequence">
            <field name="name">Équipement It</field>
            <field name="code">it.equipment</field>
            <field name="prefix">EQ-</field>
            <field name="padding">5</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_it_loan" model="ir.sequence">
            <field name="name">Prêt d'équipement</field>
            <field name="code">it.loan</field>
            <field name="prefix">LOAN/%(year)s/</field>
            <field name="padding">5</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>